{
  "name": "06_sub_minus_one",
  "title": "Subtraction via unit decrements (x - y)",
  "program": "examples/06_sub_minus_one.sipl",
  "precondition": "Y >= 0",
  "postcondition": "R = X_0 - Y_0 and Y = 0",
  "hypothesis": "R - Y = X_0 - Y_0 and Y >= 0",
  "backward_invariants": [
    "not (Y > 0) and Y >= 0 -> Y = 0 and R = X_0 - Y_0",
    "Y > 0 -> (R - 1) - (Y - 1) = R - Y and Y - 1 >= 0",
    "X_0 - Y_0 = X_0 - Y_0 and Y_0 >= 0"
  ],
  "test_domains": [
    {"input": {"X": 10, "Y": 3}, "expected": {"R": 7, "Y": 0}},
    {"input": {"X": 5, "Y": 0}, "expected": {"R": 5, "Y": 0}},
    {"input": {"X": 2, "Y": 5}, "expected": {"R": -3, "Y": 0}},
    {"input": {"X": -4, "Y": 2}, "expected": {"R": -6, "Y": 0}}
  ]
}
